generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  height    Float
  createdAt DateTime @default(now())

  weightLogs   WeightLog[]
  waterLogs    WaterLog[]
  activityLogs ActivityLog[]
  readingLogs  ReadingLog[]
  englishLogs  EnglishLog[]
  settings     UserSettings?
}

model UserSettings {
  id                         String @id @default(cuid())
  userId                     String @unique
  user                       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  waterGoalMl                Int    @default(2000)
  waterReminderIntervalHours Int    @default(2)
  weightCheckIntervalDays    Int    @default(7)
  activityGoalMinutes        Int    @default(30)
  readingGoalMinutes         Int    @default(20)
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight   Float
  loggedAt DateTime @default(now())
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())
}

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  description     String?
  loggedAt        DateTime @default(now())
}

model ReadingLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  loggedAt        DateTime @default(now())
}

model EnglishLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studied         Boolean  @default(true)
  durationMinutes Int?
  loggedAt        DateTime @default(now())
}
