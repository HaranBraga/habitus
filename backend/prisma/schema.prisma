generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  height    Float
  age       Int      @default(25)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  weightLogs     WeightLog[]
  waterLogs      WaterLog[]
  activityLogs   ActivityLog[]
  readingLogs    ReadingLog[]
  englishLogs    EnglishLog[]
  settings       UserSettings?
  groupTaskLogs  GroupTaskLog[]
}

model UserSettings {
  id                         String @id @default(cuid())
  userId                     String @unique
  user                       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  waterGoalMl                Int    @default(2000)
  waterReminderIntervalHours Int    @default(2)
  weightCheckIntervalDays    Int    @default(7)
  activityGoalMinutes        Int    @default(30)
  readingGoalMinutes         Int    @default(20)
  englishGoalMinutes         Int    @default(15)
}

model WeightLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight     Float
  isOfficial Boolean  @default(false)
  loggedAt   DateTime @default(now())
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())
}

model ActivityLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  description     String?
  loggedAt        DateTime @default(now())
}

model ReadingLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  loggedAt        DateTime @default(now())
}

model EnglishLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studied         Boolean  @default(true)
  durationMinutes Int?
  loggedAt        DateTime @default(now())
}

model GroupTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  pointValue  Int      @default(10)
  color       String   @default("#7c5cfc")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  logs GroupTaskLog[]
}

model GroupTaskLog {
  id       String    @id @default(cuid())
  taskId   String
  task     GroupTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt DateTime  @default(now())
}
